# Copy to .env and fill in. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=itvds
DB_PASSWORD=change-me
DB_NAME=itvds

# Long random string (e.g. python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-me
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# Optional tuning (defaults shown; see IMPROVEMENTS.md)
# YOLO_DEVICE=            # "" = auto (GPU if available), "cpu", "0"
# FRAME_STRIDE=2
# SAVE_ANNOTATED_VIDEO=1
# PLATE_OCR=fast          # fast | easyocr | both
# TRIPLE_MODE=count
# WRONG_LANE_MODE=either
# ACCIDENT_CONF=0.6
# ACCIDENT_MIN_SEC=1.2
